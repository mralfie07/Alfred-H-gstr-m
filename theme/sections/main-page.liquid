<article class="page-width simple-page">
  <header class="page-head">
    <h1 class="heading">{{ page.title }}</h1>
  </header>
  <div class="rte simple-page__body">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p>{{ 'pages.placeholder' | t }}</p>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .simple-page {
    padding-bottom: var(--s-8);
  }

  .simple-page__body {
    font-size: 1.0625rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sida",
  "settings": []
}
{% endschema %}
