{%- comment -%}
  "Korset": the drop as a cross on the campaign's concrete. Collections (#001, #002) run along the horizontal
  axis as tabs, colourways along the vertical axis, the emblem's star marks where they meet.
  Each block is one collection; each product in it is one colourway. A product's colour key is its handle
  after the collection number (object-001-svart-camo → svart-camo), so the same colour lines up across collections.
{%- endcomment -%}
{%- liquid
  assign order = section.settings.color_order | remove: ' ' | split: ','
  assign keys = ''
  for block in section.blocks
    for product in block.settings.collection.products limit: 12
      assign key = product.handle | split: '-' | slice: 2, 10 | join: '-'
      if key == blank
        assign key = product.handle
      endif
      assign keys = keys | append: key | append: ','
    endfor
  endfor
  assign found = keys | split: ',' | uniq
  assign color_list = ''
  for key in order
    if found contains key
      assign color_list = color_list | append: key | append: ','
    endif
  endfor
  for key in found
    unless order contains key
      assign color_list = color_list | append: key | append: ','
    endunless
  endfor
  assign colors = color_list | split: ','
  # The colour axis only appears once a drop has more than one colourway.
  assign show_colors = false
  if colors.size > 1
    assign show_colors = true
  endif

  assign start_color = section.settings.default_color | strip
  unless colors contains start_color
    assign start_color = colors.first
  endunless
  assign start_index = 0
  for key in colors
    if key == start_color
      assign start_index = forloop.index0
    endif
  endfor

  assign first_block = section.blocks.first
  assign start_side = first_block.settings.side | default: 'fram'
  assign start_product = nil
  for product in first_block.settings.collection.products limit: 12
    assign key = product.handle | split: '-' | slice: 2, 10 | join: '-'
    if key == start_color
      assign start_product = product
    endif
  endfor
  if start_product == nil
    assign start_product = first_block.settings.collection.products.first
  endif
-%}

{%- if section.blocks.size == 0 or start_product == nil -%}
  <div class="cross concrete">
    <div class="cross__inner">
      <p class="ui">{{ 'sections.cross.empty' | t }}</p>
    </div>
  </div>
{%- else -%}
  {%- capture start_number -%}{% render 'object-number', title: first_block.settings.collection.title, part: 'digits' %}{%- endcapture -%}
  <object-cross class="cross concrete" id="droppet" data-start-color="{{ start_color }}">
    <div class="cross__inner">
      {%- if section.settings.kicker != blank -%}
        <p class="cross__kicker ui ui--small" aria-hidden="true">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- liquid
        assign tabs_label = section.settings.kicker
        if tabs_label == blank
          assign tabs_label = 'sections.cross.collections' | t
        endif
      -%}
      <div class="cross__tabs" role="tablist" aria-label="{{ tabs_label | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign coll = block.settings.collection
            assign thumb = coll.products.first
            for product in coll.products limit: 12
              assign key = product.handle | split: '-' | slice: 2, 10 | join: '-'
              if key == start_color
                assign thumb = product
              endif
            endfor
          -%}
          <button
            class="cross__tab"
            type="button"
            role="tab"
            id="CrossTab-{{ section.id }}-{{ forloop.index0 }}"
            data-index="{{ forloop.index0 }}"
            aria-controls="CrossPanel-{{ section.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {% unless forloop.first %}tabindex="-1"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if thumb -%}
              {% render 'object-image', product: thumb, side: block.settings.side, width: 160, class: 'cross__thumb' %}
            {%- endif -%}
            <span class="cross__tab-number">{% render 'object-number', title: coll.title, part: 'number' %}</span>
          </button>
        {%- endfor -%}
        <span class="cross__tab-bar" aria-hidden="true" style="width: calc(100% / {{ section.blocks.size }})"></span>
      </div>

      <div class="cross__panel" id="CrossPanel-{{ section.id }}" role="tabpanel" aria-labelledby="CrossTab-{{ section.id }}-0">
        <div class="cross__axis" style="--rows: {% if show_colors %}{{ colors.size }}{% else %}0{% endif %}">
          <span class="cross__v-line" aria-hidden="true"></span>
          {%- if show_colors -%}
            <p class="cross__axis-label ui ui--small" aria-hidden="true">{{ 'sections.cross.color' | t }}</p>
          {%- endif -%}
          <span class="cross__h-line cross__h-line--start" aria-hidden="true"></span>
          <span class="cross__h-line cross__h-line--end" aria-hidden="true"></span>
          <span class="cross__star" aria-hidden="true">{% render 'icon', name: 'star' %}</span>

          {%- if show_colors -%}
          <ul class="cross__colors" role="radiogroup" aria-label="{{ 'sections.cross.color' | t }}" style="--sel: {{ start_index }}">
            {%- for key in colors -%}
              {%- liquid
                assign name = key
                assign swatch_product = nil
                for block in section.blocks
                  for product in block.settings.collection.products limit: 12
                    assign pkey = product.handle | split: '-' | slice: 2, 10 | join: '-'
                    if pkey == key and swatch_product == nil
                      assign swatch_product = product
                    endif
                  endfor
                endfor
                if swatch_product
                  capture option_name
                    render 'object-color', product: swatch_product
                  endcapture
                  assign option_name = option_name | strip
                  if option_name != blank
                    assign name = option_name
                  endif
                endif
                assign swatch = 'swatch-' | append: swatch_product.handle | append: '.webp'
              -%}
              <li class="cross__color-item{% if forloop.index0 < start_index %} cross__color-item--above{% endif %}" role="none">
                <button
                  class="cross__color"
                  type="button"
                  role="radio"
                  data-color="{{ key }}"
                  aria-checked="{% if key == start_color %}true{% else %}false{% endif %}"
                  {% unless key == start_color %}tabindex="-1"{% endunless %}
                >
                  <span class="cross__swatch" style="background-image: url('{{ swatch | asset_url }}')" aria-hidden="true"></span>
                  {{- name -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>

        <div class="cross__stage">
          <span class="cross__numeral numeral" aria-hidden="true">{{ start_number | strip }}</span>
          <div class="cross__float">
            <span class="cross__floor" aria-hidden="true"></span>
            <button class="cross__garment" type="button" aria-label="{{ 'sections.cross.flip' | t }}">
              {% render 'object-image', product: start_product, side: start_side, width: 1200, class: 'is-on', sizes: '(min-width: 600px) 560px, 92vw' %}
            </button>
          </div>
        </div>

        <div class="cross__view" role="radiogroup" aria-label="{{ 'sections.cross.side' | t }}" style="--v: {% if start_side == 'bak' %}1{% else %}0{% endif %}">
          <span class="cross__view-bar" aria-hidden="true"></span>
          <button class="ui" type="button" role="radio" data-side="fram" aria-checked="{% if start_side == 'fram' %}true{% else %}false{% endif %}">
            {{- 'products.front' | t -}}
          </button>
          <button class="ui" type="button" role="radio" data-side="bak" aria-checked="{% if start_side == 'bak' %}true{% else %}false{% endif %}">
            {{- 'products.back' | t -}}
          </button>
        </div>

        <p class="cross__data ui" aria-live="polite">
          <span data-cross-number>OBJECT {% render 'object-number', title: first_block.settings.collection.title, part: 'number' %}</span>
          <span data-cross-kind>
            {%- if start_product.type != blank -%}{{ start_product.type }}{%- else -%}{% render 'object-color', product: start_product %}{%- endif -%}
          </span>
          <span data-cross-price>{{ start_product.price | money }}</span>
        </p>

        <product-form
          class="cross__form"
          data-toast-image="{{ 'cutout-' | append: start_product.handle | append: '-' | append: start_side | append: '.webp' | asset_url }}"
          data-toast-title="{{ start_product.title | escape }}"
          data-toast-price="{{ start_product.price | money | strip_html | escape }}"
        >
          <form action="{{ routes.cart_add_url }}" method="post">
            <fieldset class="sizes cross__sizes">
              <legend class="visually-hidden">{{ 'products.size' | t }}</legend>
              {%- for variant in start_product.variants -%}
                <label class="size">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    data-size="{{ variant.options.last }}"
                    required
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  {{- variant.options.last -}}
                  {%- unless variant.available %}<span class="visually-hidden">, {{ 'products.sold_out' | t }}</span>{% endunless -%}
                </label>
              {%- endfor -%}
            </fieldset>
            <button class="button button--full" type="submit" {% unless start_product.available %}disabled{% endunless %}>
              {%- if start_product.available -%}
                {{- 'products.choose_size' | t -}}
              {%- else -%}
                {{- 'products.sold_out' | t -}}
              {%- endif -%}
            </button>
            <p class="cross__error" data-form-error role="alert"></p>
          </form>
        </product-form>

        <a class="cross__more ui link" href="{{ start_product.url }}" data-cross-link>{{ 'sections.cross.details' | t }}</a>
      </div>
    </div>

    <script type="application/json" data-cross-data>
      {
        "colors": {{ colors | json }},
        "objects": [
          {%- for block in section.blocks -%}
            {%- capture number -%}{% render 'object-number', title: block.settings.collection.title, part: 'digits' %}{%- endcapture -%}
            {
              "number": {{ number | strip | json }},
              "side": {{ block.settings.side | default: 'fram' | json }},
              "products": {
                {%- for product in block.settings.collection.products limit: 12 -%}
                  {%- liquid
                    assign key = product.handle | split: '-' | slice: 2, 10 | join: '-'
                    if key == blank
                      assign key = product.handle
                    endif
                    assign front = 'cutout-' | append: product.handle | append: '-fram.webp' | asset_url
                    assign back = 'cutout-' | append: product.handle | append: '-bak.webp' | asset_url
                  -%}
                  {{ key | json }}: {
                    "title": {{ product.title | json }},
                    {%- capture product_color -%}{% render 'object-color', product: product %}{%- endcapture -%}
                    "color": {{ product_color | strip | json }},
                    "type": {{ product.type | json }},
                    "price": {{ product.price | money | strip_html | json }},
                    "url": {{ product.url | json }},
                    "available": {{ product.available | json }},
                    "fram": {{ front | json }},
                    "bak": {{ back | json }},
                    "fallback": {{ product.featured_image | image_url: width: 1200 | json }},
                    "variants": [
                      {%- for variant in product.variants -%}
                        {"id": {{ variant.id }}, "size": {{ variant.options.last | json }}, "available": {{ variant.available | json }}}{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </object-cross>
{%- endif -%}

{% stylesheet %}
  .cross {
    --cross-axis-y: 104px;
    --cross-row: 34px;

    display: block;
    padding: var(--s-6) var(--gutter) var(--s-7);
    overflow: hidden;
  }

  .cross__inner {
    display: grid;
    gap: var(--s-5);
    max-width: 560px;
    margin: 0 auto;
  }

  .cross__panel {
    display: grid;
    gap: var(--s-4);
  }

  .cross__kicker {
    margin-bottom: calc(var(--s-3) * -1);
    color: var(--bone-dim);
  }

  /* Collections as archive tabs; the second tab starts on the cross's vertical axis. */
  .cross__tabs {
    position: relative;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    border-bottom: 1px solid var(--bone-dim);
  }

  .cross__tab {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
    padding: var(--s-2) var(--s-2) var(--s-3) 0;
    border: 0;
    text-align: start;
    color: rgb(236 230 220 / 0.5);
    background: none;
    transition: color 0.45s var(--ease-out);

    &:hover,
    &[aria-selected="true"] {
      color: var(--bone);
    }

    &[aria-selected="true"] .cross__thumb {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .cross__thumb {
    flex: none;
    width: 54px;
    height: 54px;
    object-fit: contain;
    opacity: 0.45;
    filter: drop-shadow(0 4px 4px rgb(12 12 11 / 0.3));
    transition: opacity 0.45s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .cross__tab-number {
    font-stretch: 125%;
    font-weight: 300;
    font-size: clamp(1.5rem, 7vw, 2.125rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .cross__tab-bar {
    position: absolute;
    inset-inline-start: 0;
    bottom: -1px;
    height: 2px;
    background: var(--bone);
    transform: translateX(calc(var(--o, 0) * 100%));
    transition: transform 0.55s var(--ease-out);
  }

  /* The axis sits above the garment so the lowest colour stays tappable where they overlap. */
  .cross__axis {
    position: relative;
    z-index: 2;
    height: calc(var(--cross-axis-y) + var(--cross-row) * var(--rows, 3) + 20px);
    pointer-events: none;

    & button {
      pointer-events: auto;
    }
  }

  .cross__v-line {
    position: absolute;
    inset-inline-start: 50%;
    top: 0;
    width: 1px;
    height: calc(var(--cross-axis-y) + var(--cross-row) * 1.5);
    background: var(--bone-dim);
    transform: translateX(-0.5px);
  }

  .cross__axis-label {
    position: absolute;
    top: -2px;
    inset-inline-end: calc(50% + 12px);
    color: var(--bone-dim);
  }

  .cross__h-line {
    position: absolute;
    top: var(--cross-axis-y);
    height: 1px;
    background: var(--bone-dim);
  }

  .cross__h-line--start {
    inset-inline: 0 calc(50% + 28px);
  }

  .cross__h-line--end {
    inset-inline: calc(50% + 28px) 0;
  }

  .cross__star {
    position: absolute;
    inset-inline-start: 50%;
    top: var(--cross-axis-y);
    width: 40px;
    height: 40px;
    color: var(--bone);
    transform: translate(-50%, -50%) rotate(var(--turn, 0deg));
    transition: transform 0.7s var(--ease-out);

    & svg {
      width: 100%;
      height: 100%;
    }
  }

  .cross__colors {
    position: absolute;
    inset-inline-start: calc(50% + 18px);
    top: calc(var(--cross-axis-y) + 16px);
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(calc(var(--sel, 0) * var(--cross-row) * -1));
    transition: transform 0.6s var(--ease-out);
  }

  .cross__color-item {
    transition: transform 0.6s var(--ease-out);
  }

  .cross__color-item--above {
    transform: translateY(-34px);
  }

  .cross__color {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--cross-row);
    padding: 0;
    border: 0;
    white-space: nowrap;
    font-stretch: 112%;
    font-size: clamp(0.9375rem, 4.1vw, 1.25rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(236 230 220 / 0.62);
    background: none;
    transition: color 0.4s var(--ease-out);

    &:hover,
    &[aria-checked="true"] {
      color: var(--bone);
    }

    &::before {
      content: "";
      flex: none;
      width: 8px;
      height: 8px;
      margin-inline: -23px 5px;
      border-radius: 50%;
      background: var(--terra);
      opacity: 0;
      transform: scale(0.4);
      transition: opacity 0.3s, transform 0.5s var(--ease-out);
    }

    &[aria-checked="true"]::before {
      opacity: 1;
      transform: none;
    }

    &[aria-checked="true"] .cross__swatch {
      box-shadow: 0 0 0 1px var(--bone);
    }

    &[aria-disabled="true"] {
      color: var(--bone-faint);
      cursor: not-allowed;
    }
  }

  .cross__swatch {
    flex: none;
    width: 15px;
    height: 15px;
    background: center / cover;
    box-shadow: 0 0 0 1px var(--bone-faint);
    transition: box-shadow 0.4s var(--ease-out);
  }

  /* Garment */
  .cross__stage {
    position: relative;
    aspect-ratio: 1 / 1.02;
    margin-top: calc(var(--cross-row) * -1.2);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .cross__numeral {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: min(52vw, 300px);
    color: var(--bone-dim);
    transition: opacity 0.35s, transform 0.7s var(--ease-out);
  }

  .cross__numeral--out-start {
    opacity: 0;
    transform: translateX(-12%);
  }

  .cross__numeral--out-end {
    opacity: 0;
    transform: translateX(12%);
  }

  .cross__float {
    position: absolute;
    inset: 0;
    animation: cross-float 7s ease-in-out infinite;
  }

  .cross__garment {
    position: absolute;
    inset: 1% 2% 11%;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;

    & img {
      grid-area: 1 / 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      -webkit-user-drag: none;
      filter: drop-shadow(0 18px 16px rgb(12 12 11 / 0.32));
      opacity: 0;
      transform: translateX(var(--from, 0)) scale(0.97);
      transition: opacity 0.45s var(--ease-out), transform 0.75s var(--ease-out);
    }

    & img.is-on {
      opacity: 1;
      transform: none;
    }
  }

  .cross__floor {
    position: absolute;
    inset-inline: 22%;
    bottom: 5%;
    height: 7%;
    border-radius: 50%;
    background: rgb(12 12 11 / 0.55);
    filter: blur(14px);
    animation: cross-shadow 7s ease-in-out infinite;
  }

  @keyframes cross-float {
    50% {
      transform: translateY(-7px);
    }
  }

  @keyframes cross-shadow {
    50% {
      transform: scaleX(0.9);
      opacity: 0.8;
    }
  }

  /* Front/back: a bone block slides under the chosen side. */
  .cross__view {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-self: center;
    width: min(100%, 264px);
    margin-top: calc(var(--s-3) * -1);
    border: 1px solid var(--bone-dim);

    & button {
      position: relative;
      height: 42px;
      padding: 0 var(--s-3);
      border: 0;
      font-size: 0.6875rem;
      color: var(--bone);
      background: none;
      transition: color 0.45s var(--ease-out);

      &[aria-checked="true"] {
        color: var(--ink);
      }
    }
  }

  .cross__view-bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 50%;
    background: var(--bone);
    transform: translateX(calc(var(--v, 0) * 100%));
    transition: transform 0.55s var(--ease-out);
  }

  .cross__data {
    text-align: center;

    & span + span::before {
      content: "·";
      margin: 0 0.7em;
      color: var(--bone-dim);
    }
  }

  .cross__form form {
    display: grid;
    gap: var(--s-4);
  }

  .cross__sizes {
    justify-content: center;
  }

  .cross__error:empty {
    display: none;
  }

  .cross__more {
    justify-self: center;
    color: var(--bone);
  }
{% endstylesheet %}

{% javascript %}
  class ObjectCross extends HTMLElement {
    connectedCallback() {
      const data = JSON.parse(this.querySelector('[data-cross-data]').textContent);
      this.colors = data.colors;
      this.objects = data.objects;
      this.state = { o: 0, c: this.dataset.startColor, v: this.objects[0].side, size: null };
      this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.garment = this.querySelector('.cross__garment');
      this.current = this.garment.querySelector('img');
      this.engaged = false;
      this.#preload();
      this.#bind();
      this.#syncColors();
      this.#demoOnce();
    }

    get product() {
      const obj = this.objects[this.state.o];
      return obj.products[this.state.c] || Object.values(obj.products)[0];
    }

    #preload() {
      const load = () => {
        for (const obj of this.objects) {
          for (const p of Object.values(obj.products)) {
            for (const side of ['fram', 'bak']) new Image().src = p[side];
          }
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(load);
      else setTimeout(load, 1500);
    }

    #bind() {
      for (const tab of this.querySelectorAll('.cross__tab')) {
        tab.addEventListener('click', () => this.#goObject(Number(tab.dataset.index)));
      }
      this.querySelector('.cross__tabs').addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        const next = this.state.o + step;
        if (next < 0 || next >= this.objects.length) return;
        event.preventDefault();
        this.#goObject(next);
        this.querySelectorAll('.cross__tab')[next].focus();
      });

      for (const button of this.querySelectorAll('.cross__color')) {
        button.addEventListener('click', () => {
          const color = button.dataset.color;
          if (color === this.state.c || !this.objects[this.state.o].products[color]) return;
          this.state.c = color;
          this.#render();
        });
      }

      for (const button of this.querySelectorAll('.cross__view button')) {
        button.addEventListener('click', () => this.#setView(button.dataset.side));
      }

      // Arrow keys move between options in the colour and side radiogroups.
      for (const group of this.querySelectorAll('[role="radiogroup"]')) {
        group.addEventListener('keydown', (event) => {
          const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
          if (!step) return;
          const items = [...group.querySelectorAll('[role="radio"]:not([aria-disabled="true"])')];
          const index = items.indexOf(document.activeElement);
          if (index < 0) return;
          const next = items[(index + step + items.length) % items.length];
          event.preventDefault();
          next.focus();
          next.click();
        });
      }

      // A sideways swipe on the garment turns it over; a tap does too. Collections change only with the tabs.
      const stage = this.querySelector('.cross__stage');
      let x0 = null;
      let y0 = null;
      let swiped = false;
      stage.addEventListener('pointerdown', (event) => {
        x0 = event.clientX;
        y0 = event.clientY;
        swiped = false;
      });
      stage.addEventListener('pointercancel', () => {
        x0 = null;
      });
      stage.addEventListener('pointerup', (event) => {
        if (x0 === null) return;
        const dx = event.clientX - x0;
        const dy = event.clientY - y0;
        x0 = null;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        swiped = true;
        setTimeout(() => (swiped = false), 50);
        this.#setView(this.state.v === 'fram' ? 'bak' : 'fram', dx < 0 ? 1 : -1);
      });
      this.garment.addEventListener('click', () => {
        if (swiped) return;
        this.#setView(this.state.v === 'fram' ? 'bak' : 'fram');
      });

      this.querySelector('.cross__sizes').addEventListener('change', (event) => {
        this.state.size = event.target.dataset.size;
      });

      for (const type of ['click', 'keydown']) {
        this.addEventListener(type, () => (this.engaged = true), { capture: true });
      }
    }

    #setView(side, dir = 0) {
      if (side === this.state.v) return;
      this.state.v = side;
      this.#render({ from: dir * 60 });
    }

    #goObject(index) {
      const dir = index - this.state.o;
      if (!dir) return;
      this.state.o = index;
      this.state.v = this.objects[index].side;
      if (!this.objects[index].products[this.state.c]) {
        this.state.c = Object.keys(this.objects[index].products)[0];
      }
      const star = this.querySelector('.cross__star');
      star.style.setProperty('--turn', star.style.getPropertyValue('--turn') === '90deg' ? '0deg' : '90deg');
      this.#render({ from: Math.sign(dir) * 110, numeral: Math.sign(dir) });
    }

    #syncColors() {
      const list = this.querySelector('.cross__colors');
      if (!list) return;
      const index = this.colors.indexOf(this.state.c);
      list.style.setProperty('--sel', index);
      const products = this.objects[this.state.o].products;
      list.querySelectorAll('.cross__color-item').forEach((item, i) => {
        item.classList.toggle('cross__color-item--above', i < index);
        const button = item.querySelector('button');
        const on = button.dataset.color === this.state.c;
        button.setAttribute('aria-checked', String(on));
        button.tabIndex = on ? 0 : -1;
        if (products[button.dataset.color]) button.removeAttribute('aria-disabled');
        else button.setAttribute('aria-disabled', 'true');
      });
    }

    #render({ from = 0, numeral = 0 } = {}) {
      const product = this.product;
      const obj = this.objects[this.state.o];
      this.#syncColors();

      // Tabs: selection, sliding bar, thumbnails in the chosen colour.
      this.querySelector('.cross__tabs').style.setProperty('--o', this.state.o);
      this.querySelectorAll('.cross__tab').forEach((tab, i) => {
        const on = i === this.state.o;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const p = this.objects[i].products[this.state.c];
        const thumb = tab.querySelector('img');
        if (p && thumb) thumb.src = p[this.objects[i].side];
      });
      this.querySelector('.cross__panel').setAttribute('aria-labelledby', this.querySelectorAll('.cross__tab')[this.state.o].id);

      const view = this.querySelector('.cross__view');
      view.style.setProperty('--v', this.state.v === 'fram' ? 0 : 1);
      for (const button of view.querySelectorAll('button')) {
        button.setAttribute('aria-checked', String(button.dataset.side === this.state.v));
      }

      this.querySelector('[data-cross-number]').textContent = `OBJECT #${obj.number}`;
      this.querySelector('[data-cross-kind]').textContent = product.type || product.color;
      this.querySelector('[data-cross-price]').textContent = product.price;
      this.querySelector('[data-cross-link]').href = product.url;

      if (numeral) {
        const n = this.querySelector('.cross__numeral');
        n.classList.add(numeral > 0 ? 'cross__numeral--out-start' : 'cross__numeral--out-end');
        setTimeout(() => {
          n.textContent = obj.number;
          n.classList.remove('cross__numeral--out-start', 'cross__numeral--out-end');
        }, 280);
      }

      this.#renderForm(product);
      this.#showGarment(product, from);
    }

    #renderForm(product) {
      const form = this.querySelector('product-form');
      form.dataset.toastImage = product[this.objects[this.state.o].side];
      form.dataset.toastTitle = product.title;
      form.dataset.toastPrice = product.price;

      const fieldset = this.querySelector('.cross__sizes');
      const legend = fieldset.querySelector('legend');
      fieldset.replaceChildren(legend);
      for (const variant of product.variants) {
        const label = document.createElement('label');
        label.className = 'size';
        const input = document.createElement('input');
        Object.assign(input, { type: 'radio', name: 'id', value: variant.id, required: true, disabled: !variant.available });
        input.dataset.size = variant.size;
        input.checked = variant.available && variant.size === this.state.size;
        label.append(input, variant.size);
        if (!variant.available) {
          const note = document.createElement('span');
          note.className = 'visually-hidden';
          note.textContent = `, ${window.theme.strings.soldOut}`;
          label.append(note);
        }
        fieldset.append(label);
      }

      const button = form.querySelector('[type="submit"]');
      button.disabled = !product.available;
      button.textContent = product.available ? window.theme.strings.chooseSize : window.theme.strings.soldOut;
      form.querySelector('form').dispatchEvent(new Event('change'));
    }

    #showGarment(product, from) {
      const img = document.createElement('img');
      img.src = product[this.state.v];
      img.alt = `${product.title}, ${this.querySelector(`.cross__view [data-side="${this.state.v}"]`).textContent.trim().toLowerCase()}`;
      img.draggable = false;
      img.width = 1200;
      img.height = 1200;
      img.onerror = () => {
        img.onerror = null;
        if (product.fallback) img.src = product.fallback;
      };
      img.style.setProperty('--from', `${from}px`);
      this.garment.append(img);
      requestAnimationFrame(() => requestAnimationFrame(() => img.classList.add('is-on')));
      if (this.current) {
        const old = this.current;
        old.style.setProperty('--from', `${-from}px`);
        old.classList.remove('is-on');
        setTimeout(() => old.remove(), 600);
      }
      this.current = img;
    }

    // One-time demonstration the first time the garment is in view and untouched: it leans as if swiped while
    // the front/back block reaches over; then the other collection's tab lights up; then the other fabrics tick.
    #demoOnce() {
      if (this.reduce || !('IntersectionObserver' in window) || this.objects.length < 1) return;
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        io.disconnect();
        setTimeout(() => this.#demo(), 700);
      }, { threshold: 0.6 });
      io.observe(this.querySelector('.cross__stage'));
    }

    #demo() {
      if (this.engaged) return;
      const ease = 'cubic-bezier(.45, 0, .2, 1)';
      this.garment.animate(
        [
          { transform: 'none' },
          { transform: 'translateX(-38px) rotate(-1.5deg)', offset: 0.36 },
          { transform: 'translateX(6px) rotate(.3deg)', offset: 0.7 },
          { transform: 'none' },
        ],
        { duration: 1400, easing: ease }
      );
      const v = this.state.v === 'fram' ? 0 : 100;
      const reach = v ? v - 18 : 18;
      this.querySelector('.cross__view-bar').animate(
        [{ transform: `translateX(${v}%)` }, { transform: `translateX(${reach}%)`, offset: 0.36 }, { transform: `translateX(${v}%)` }],
        { duration: 1400, easing: ease }
      );
      if (this.objects.length > 1) {
        const o = this.state.o;
        const d = o === 0 ? 1 : -1;
        this.querySelector('.cross__tab-bar').animate(
          [{ transform: `translateX(${o * 100}%)` }, { transform: `translateX(${o * 100 + d * 14}%) scaleX(1.12)`, offset: 0.4 }, { transform: `translateX(${o * 100}%)` }],
          { duration: 1300, delay: 1500, easing: ease }
        );
        this.querySelector('.cross__tab:not([aria-selected="true"]) .cross__thumb')?.animate(
          [{ opacity: 0.45, transform: 'none' }, { opacity: 1, transform: 'translateY(-4px)', offset: 0.4 }, { opacity: 0.45, transform: 'none' }],
          { duration: 1300, delay: 1500, easing: ease }
        );
      }
      this.querySelectorAll('.cross__color:not([aria-checked="true"]) .cross__swatch').forEach((swatch, i) =>
        swatch.animate([{ transform: 'none' }, { transform: 'scale(1.45)', offset: 0.4 }, { transform: 'none' }], {
          duration: 560,
          delay: 2900 + i * 160,
          easing: 'cubic-bezier(.16, 1, .3, 1)',
        })
      );
    }
  }

  if (!customElements.get('object-cross')) customElements.define('object-cross', ObjectCross);
{% endjavascript %}

{% schema %}
{
  "name": "Korset",
  "tag": "section",
  "class": "section-cross",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Varje block är en kollektion (#001, #002 …). Varje produkt i kollektionen är en färg. Färgen läses från produktens webbadress efter numret, t.ex. object-001-svart-camo → svart-camo."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Rad ovanför flikarna",
      "default": "Drop 01 · två objekt"
    },
    {
      "type": "text",
      "id": "color_order",
      "label": "Färgernas ordning",
      "default": "svart-camo,svart,bla",
      "info": "Kommaseparerat. Färger som inte står med hamnar sist."
    },
    {
      "type": "text",
      "id": "default_color",
      "label": "Färg som visas först",
      "default": "svart-camo"
    }
  ],
  "blocks": [
    {
      "type": "object",
      "name": "Kollektion",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "select",
          "id": "side",
          "label": "Sida som visas först",
          "default": "fram",
          "options": [
            { "value": "fram", "label": "Framsida" },
            { "value": "bak", "label": "Baksida" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Korset",
      "blocks": [
        { "type": "object", "settings": { "side": "fram" } },
        { "type": "object", "settings": { "side": "bak" } }
      ]
    }
  ]
}
{% endschema %}
