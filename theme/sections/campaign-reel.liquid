{%- liquid
  assign frames = section.blocks.size
-%}
<campaign-reel class="reel" role="region" aria-label="{{ 'motion.campaign' | t }}">
  <div class="reel__head page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="ui" data-scramble>{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if frames > 1 -%}
      <div class="reel__controls">
        <p class="reel__count ui" aria-hidden="true">
          <span class="reel__index" data-reel-index data-roll-value="01">01</span>
          <span class="reel__total">/ {% if frames < 10 %}0{% endif %}{{ frames }}</span>
        </p>
        {%- comment -%} aria-disabled, not disabled: a focused button that disables itself would drop focus. {%- endcomment -%}
        <button class="reel__nav reel__nav--prev" type="button" data-reel-step="-1" aria-label="{{ 'motion.prev' | t }}" aria-disabled="true">
          {%- render 'icon', name: 'arrow' -%}
        </button>
        <button class="reel__nav" type="button" data-reel-step="1" aria-label="{{ 'motion.next' | t }}" aria-disabled="false">
          {%- render 'icon', name: 'arrow' -%}
        </button>
        <p class="visually-hidden" aria-live="polite" data-reel-status></p>
      </div>
    {%- endif -%}
  </div>

  <div class="reel__stage">
    {%- if section.settings.word != blank -%}
      <p class="reel__word" aria-hidden="true">{{ section.settings.word }}</p>
    {%- endif -%}

    {%- comment -%}
      A plain sideways scroller: swipe, trackpad, keyboard (when focused), the arrows, or drag with a
      mouse. Scrolling down always carries on down the page; nothing is pinned or hijacked.
    {%- endcomment -%}
    <ul
      class="reel__track"
      role="list"
      tabindex="0"
      aria-label="{{ 'motion.strip' | t }}"
      data-reel-track
      data-reveal="slide"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback = block.settings.fallback | strip
          # The figcaption names the picture; only a merchant's own alt text is added.
          assign alt = block.settings.image.alt | default: ''
          assign loading = 'lazy'
          if forloop.index <= 2
            assign loading = 'eager'
          endif
        -%}
        <li class="reel__frame" {{ block.shopify_attributes }}>
          <figure>
            <div class="reel__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 900px) 62vw, 80vw',
                    loading: loading,
                    draggable: 'false',
                    alt: alt
                }}
              {%- elsif fallback != blank -%}
                <img
                  src="{{ fallback | append: '-1600.webp' | asset_url }}"
                  srcset="{{ fallback | append: '-800.webp' | asset_url }} 800w, {{ fallback | append: '-1600.webp' | asset_url }} 1600w"
                  sizes="(min-width: 900px) 62vw, 80vw"
                  alt=""
                  width="1600"
                  height="893"
                  loading="{{ loading }}"
                  draggable="false"
                >
              {%- endif -%}
            </div>
            <figcaption class="reel__caption ui ui--small">
              <span>{{ 'motion.frame' | t }} {% if forloop.index < 10 %}00{% elsif forloop.index < 100 %}0{% endif %}{{ forloop.index }}</span>
              {%- if block.settings.caption != blank %}<span class="muted">{{ block.settings.caption }}</span>{% endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>

    {%- if frames > 1 -%}
      <div class="reel__progress page-width" aria-hidden="true"><span></span></div>
    {%- endif -%}
  </div>
</campaign-reel>

{% stylesheet %}
  /* The campaign as a film strip you scroll sideways. It takes up its own height on the page and
     nothing more: scrolling down passes straight through it. */
  .reel {
    --frame-w: min(80vw, 420px);
    --frame-ratio: 4 / 5;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-7);
    background: var(--ink);
    overflow: clip;

    @media (min-width: 900px) {
      --frame-w: min(62vw, 104svh);
      --frame-ratio: 1600 / 893;
    }

    /* A phone on its side: wide frames that fit under the header with their caption. */
    @media (max-width: 899px) and (orientation: landscape) {
      --frame-w: min(72vw, calc((100svh - var(--header-h) - 7.5rem) * 1.79));
      --frame-ratio: 1600 / 893;
    }
  }

  .reel__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    width: 100%;
  }

  .reel__controls {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .reel__count {
    display: flex;
    gap: 0.5em;
    margin-inline-end: var(--s-2);
    font-variant-numeric: tabular-nums;
  }

  .reel__total {
    color: var(--bone-dim);
  }

  .reel__nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--bone-dim);
    color: var(--bone);
    background: none;
    transition: border-color 0.2s, opacity 0.2s, scale 0.15s var(--ease-out);

    & svg {
      width: 18px;
      height: 18px;
    }

    &:active:not([aria-disabled="true"]) {
      scale: 0.94;
    }

    &[aria-disabled="true"] {
      opacity: 0.3;
      cursor: default;
    }

    @media (hover: hover) and (pointer: fine) {
      &:hover:not([aria-disabled="true"]) {
        border-color: var(--bone);
      }
    }
  }

  /* The arrows, counter and progress line only work with the script, so they wait for it. */
  campaign-reel:not(:defined) :is(.reel__controls, .reel__progress) {
    visibility: hidden;
  }

  .reel__nav--prev svg {
    rotate: 180deg;
  }

  .reel__stage {
    position: relative;
    display: grid;
    gap: var(--s-4);
    isolation: isolate;
  }

  /* Frames snap to the middle, with the neighbours showing at both edges. */
  .reel__track {
    position: relative;
    display: flex;
    gap: clamp(0.75rem, 3vw, 2rem);
    margin: 0;
    padding: 0 max(var(--gutter), calc((100% - var(--frame-w)) / 2));
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;

    &::-webkit-scrollbar {
      display: none;
    }

    &:focus-visible {
      outline: 2px solid var(--bone);
      outline-offset: -2px;
    }
  }

  /* A mouse can grab the strip; while it drags, the strip follows the hand and settles on a
     frame when let go. */
  @media (hover: hover) and (pointer: fine) {
    campaign-reel:defined .reel__track {
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
  }

  /* While a mouse drags, and while the strip glides to a frame, snapping waits. */
  .reel__track.is-free {
    scroll-snap-type: none;
  }

  .reel__track.is-dragging {
    cursor: grabbing;
  }

  .reel__frame {
    flex: none;
    width: var(--frame-w);
    scroll-snap-align: center;
    scroll-snap-stop: always;

    & figure {
      display: grid;
      gap: var(--s-3);
      margin: 0;
    }
  }

  .reel__media {
    position: relative;
    aspect-ratio: var(--frame-ratio);
    overflow: clip;
    background: var(--char);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      -webkit-user-drag: none;
    }
  }

  .reel__caption {
    display: flex;
    gap: var(--s-4);
    color: var(--bone);
  }

  /* How far along the strip you are: a hairline that fills as you scroll sideways. */
  .reel__progress {
    width: 100%;

    & span {
      display: block;
      height: 1px;
      background: linear-gradient(var(--bone), var(--bone)) 0 0 / calc(var(--progress, 0) * 100%) 100% no-repeat, var(--rule);
    }
  }

  .reel__word {
    display: none;
  }

  /* Motion, driven by the strip's own sideways scroll. The giant word is for wide screens: on a
     phone it would sit entirely behind the picture. */
  @media (min-width: 900px) {
    .motion .reel__word {
      position: absolute;
      inset: auto 0 12% 0;
      z-index: -1;
      display: block;
      margin: 0;
      white-space: nowrap;
      font-stretch: 125%;
      font-weight: 300;
      font-size: clamp(8rem, 38vw, 30rem);
      line-height: 0.8;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      color: rgb(236 230 220 / 0.05);
      pointer-events: none;
      translate: calc(8% - var(--progress, 0) * 40%) 0;
      transition: translate 0.6s var(--ease-out);
    }
  }

  .reel__track[data-reveal="slide"][data-reveal-state="waiting"] {
    opacity: 0;
    translate: 25% 0;
  }

  .reel__track[data-reveal="slide"] {
    transition:
      opacity 0.9s var(--ease-out) var(--reveal-delay, 0s),
      translate 1.4s var(--ease-out) var(--reveal-delay, 0s);
  }

  @supports (animation-timeline: view(inline)) {
    /* Each picture drifts inside its window as it crosses; the frame in the middle is sharp. */
    .motion .reel__media img {
      scale: 1.16;
      animation: reel-drift linear both;
      animation-timeline: view(inline);
    }

    /* Only the picture dims, so the captions beside it stay readable. */
    .motion .reel__media {
      animation: reel-focus linear both;
      animation-timeline: view(inline);
    }
  }

  @keyframes reel-drift {
    from {
      translate: 7% 0;
    }
    to {
      translate: -7% 0;
    }
  }

  @keyframes reel-focus {
    0%,
    100% {
      opacity: 0.4;
      scale: 0.93;
    }
    50% {
      opacity: 1;
      scale: 1;
    }
  }
{% endstylesheet %}

{% javascript %}
  class CampaignReel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-reel-track]');
      this.frames = [...this.querySelectorAll('.reel__frame')];
      this.index = this.querySelector('[data-reel-index]');
      this.status = this.querySelector('[data-reel-status]');
      this.prev = this.querySelector('[data-reel-step="-1"]');
      this.next = this.querySelector('[data-reel-step="1"]');
      this.current = -1;
      this.target = null;
      this.dragging = false;
      if (!this.track || this.frames.length < 2) return;

      // One controller for every listener, so a re-render or a move in the theme editor can't double them.
      this.life?.abort();
      this.life = new AbortController();
      const { signal } = this.life;
      const passive = { passive: true, signal };

      this.onScroll = () => {
        if (!this.raf) this.raf = requestAnimationFrame(() => this.#update());
      };
      this.track.addEventListener('scroll', this.onScroll, passive);
      window.addEventListener('resize', this.onScroll, passive);
      this.track.addEventListener('scrollend', () => this.#rest(), passive);
      for (const button of [this.prev, this.next]) {
        button?.addEventListener('click', () => this.#step(Number(button.dataset.reelStep)), { signal });
      }
      // Home and End jump to the first and last frame (arrow keys scroll the strip natively).
      this.track.addEventListener(
        'keydown',
        (event) => {
          const to = { Home: 0, End: this.frames.length - 1 }[event.key];
          if (to === undefined) return;
          event.preventDefault();
          this.goTo(to);
        },
        { signal }
      );
      // A finger takes over from anything still moving the strip, with native snapping back on.
      this.track.addEventListener('touchstart', () => this.#interrupt(), passive);
      // Theme editor: selecting a frame's block brings it to the middle.
      this.addEventListener(
        'shopify:block:select',
        (event) => {
          const i = this.frames.indexOf(event.target);
          if (i >= 0) this.goTo(i, false);
        },
        { signal }
      );
      this.#drag(signal);
      this.#wheel(signal);
      this.#update();
    }

    disconnectedCallback() {
      this.life?.abort();
      this.#interrupt();
      cancelAnimationFrame(this.raf);
      this.raf = 0;
    }

    get #max() {
      return this.track.scrollWidth - this.track.clientWidth;
    }

    get #still() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    #clamp(i) {
      return Math.max(0, Math.min(this.frames.length - 1, i));
    }

    /** Scroll position that puts frame `i` in the middle of the strip. */
    #leftFor(i) {
      const frame = this.frames[i];
      const left = frame.offsetLeft + frame.offsetWidth / 2 - this.track.clientWidth / 2;
      return Math.max(0, Math.min(this.#max, left));
    }

    #nearest() {
      const middle = this.track.scrollLeft + this.track.clientWidth / 2;
      let best = 0;
      let distance = Infinity;
      this.frames.forEach((frame, i) => {
        const d = Math.abs(frame.offsetLeft + frame.offsetWidth / 2 - middle);
        if (d < distance) {
          distance = d;
          best = i;
        }
      });
      return best;
    }

    /**
     * Brings frame `i` to the middle. Remembers it as the target while the strip glides there, so
     * quick clicks add up instead of stepping from a frame that is still leaving.
     * @param {number} i
     * @param {boolean} [smooth]
     */
    goTo(i, smooth = true) {
      const target = this.#clamp(i);
      if (!smooth || this.#still) {
        this.#interrupt();
        this.track.scrollLeft = this.#leftFor(target);
        this.#rest();
        return;
      }
      this.#glide(target, this.glide ? this.velocity : 0);
    }

    #step(dir) {
      const button = dir < 0 ? this.prev : this.next;
      if (button?.getAttribute('aria-disabled') === 'true') return;
      this.goTo((this.target ?? this.#nearest()) + dir);
    }

    /**
     * Every programmatic move (arrows, keys, wheel, letting go after a drag) glides on the same
     * critically damped spring: it starts from the speed the strip already has (px/ms, in scroll
     * direction), never overshoots, and rests in about half a second. Snapping is off meanwhile.
     */
    #glide(i, velocity = 0) {
      this.#interrupt(true);
      const target = this.#clamp(i);
      const to = this.#leftFor(target);
      this.target = target;
      this.track.classList.add('is-free');
      const w = 12; // per second
      const x0 = this.track.scrollLeft - to;
      const v0 = velocity * 1000;
      const b = v0 + w * x0;
      const t0 = performance.now();
      const frame = (now) => {
        const t = (now - t0) / 1000;
        const e = Math.exp(-w * t);
        const x = (x0 + b * t) * e;
        const v = (v0 - w * b * t) * e;
        this.velocity = v / 1000;
        if (Math.abs(x) < 0.5 && Math.abs(v) < 20) {
          this.track.scrollLeft = to;
          this.#settle();
          return;
        }
        this.track.scrollLeft = to + x;
        this.glide = requestAnimationFrame(frame);
      };
      this.glide = requestAnimationFrame(frame);
    }

    #settle() {
      this.glide = 0;
      this.velocity = 0;
      this.track.classList.remove('is-free');
      this.#rest();
    }

    /**
     * Anything that takes over the strip stops whatever was moving it.
     * @param {boolean} [keepFree] Leave snapping off (a new glide or the hand takes over at once)
     */
    #interrupt(keepFree = false) {
      cancelAnimationFrame(this.glide);
      this.glide = 0;
      this.target = null;
      if (!keepFree && !this.dragging) this.track.classList.remove('is-free');
    }

    // The strip came to rest: the counter catches up and screen readers hear where it stopped.
    #rest() {
      if (this.dragging || this.glide) return;
      this.target = null;
      this.#count(this.#nearest());
      this.#announce();
    }

    #announce() {
      if (!this.status) return;
      const i = this.#nearest();
      if (i === this.announced) return;
      const first = this.announced === undefined;
      this.announced = i;
      if (first) return;
      const caption = [...this.frames[i].querySelectorAll('figcaption span')].map((span) => span.textContent.trim());
      this.status.textContent = `${caption.join(', ')} (${i + 1}/${this.frames.length})`;
    }

    /** Rolls the counter to frame `best`: quick enough to keep up with a hand. */
    #count(best) {
      if (best === this.current || !this.index) return;
      const first = this.current < 0;
      const dir = best > this.current ? 1 : -1;
      this.current = best;
      const label = String(best + 1).padStart(2, '0');
      if (!first && window.theme?.rollTo) window.theme.rollTo(this.index, label, dir, { duration: 420, stagger: 60 });
      else {
        this.index.textContent = label;
        this.index.dataset.rollValue = label;
      }
    }

    // Progress line, the word behind and the arrows follow the strip on every frame. The counter
    // follows too, except on the way to a farther target: then it rolls once, on arrival.
    #update() {
      this.raf = 0;
      const max = this.#max;
      const left = this.track.scrollLeft;
      this.style.setProperty('--progress', (max > 0 ? left / max : 0).toFixed(4));
      this.prev?.setAttribute('aria-disabled', String(left <= 2));
      this.next?.setAttribute('aria-disabled', String(left >= max - 2));
      const best = this.#nearest();
      if (this.target === null || this.target === best) this.#count(best);
    }

    // Sideways wheel and trackpad scrolling (and Shift + wheel): one deliberate push moves one
    // frame, at once, in one glide, like a swipe; the rest of that gesture (its momentum tail) is
    // swallowed. Vertical wheel scrolling is never touched, so the page carries on down.
    #wheel(signal) {
      let sum = 0;
      let locked = false;
      let quiet = 0;
      this.track.addEventListener(
        'wheel',
        (event) => {
          if (!event.shiftKey && Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
          event.preventDefault();
          const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? this.track.clientWidth : 1;
          clearTimeout(quiet);
          quiet = setTimeout(() => {
            sum = 0;
            locked = false;
          }, 150);
          if (locked) return;
          sum += (event.deltaX || event.deltaY) * unit;
          if (Math.abs(sum) < 50) return;
          locked = true;
          this.goTo((this.target ?? this.#nearest()) + Math.sign(sum));
        },
        { signal }
      );
    }

    // A mouse can drag the strip (touch and trackpads scroll it natively). The page's own
    // vertical scrolling is never touched.
    #drag(signal) {
      let drag = null;
      const track = this.track;
      const end = (event) => {
        if (!drag || event.pointerId !== drag.id) return;
        const { moved, lastT, start } = drag;
        // A hand that stopped before letting go is not flicking.
        const v = performance.now() - lastT > 100 ? 0 : drag.v;
        drag = null;
        this.dragging = false;
        track.classList.remove('is-dragging');
        if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
        if (!moved) return;
        // A flick goes on one frame from where the drag began; otherwise the nearest frame.
        const nearest = this.#nearest();
        const flick = Math.abs(v) > 0.35 ? -Math.sign(v) : 0;
        this.#glide(flick && nearest === start ? start + flick : nearest, -v);
      };
      track.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType !== 'mouse' || event.button !== 0) return;
          // Captured from the start, so letting go anywhere ends the drag.
          track.setPointerCapture(event.pointerId);
          const now = performance.now();
          drag = { id: event.pointerId, x: event.clientX, left: track.scrollLeft, start: this.#nearest(), moved: false, lastX: event.clientX, lastT: now, v: 0 };
        },
        { signal }
      );
      track.addEventListener(
        'pointermove',
        (event) => {
          if (!drag || event.pointerId !== drag.id) return;
          if (!(event.buttons & 1)) {
            end(event);
            return;
          }
          const dx = event.clientX - drag.x;
          if (!drag.moved) {
            if (Math.abs(dx) < 4) return;
            drag.moved = true;
            this.#interrupt(true);
            this.dragging = true;
            track.classList.add('is-dragging', 'is-free');
            // Start from where the strip is now, in case it was still moving.
            drag.left = track.scrollLeft + dx;
          }
          track.scrollLeft = drag.left - dx;
          const now = performance.now();
          drag.v = (event.clientX - drag.lastX) / Math.max(1, now - drag.lastT);
          drag.lastX = event.clientX;
          drag.lastT = now;
        },
        { signal }
      );
      for (const type of ['pointerup', 'pointercancel', 'lostpointercapture']) {
        track.addEventListener(type, end, { signal });
      }
    }
  }

  if (!customElements.get('campaign-reel')) customElements.define('campaign-reel', CampaignReel);
{% endjavascript %}

{% schema %}
{
  "name": "Kampanjband",
  "tag": "div",
  "class": "section-reel",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Rad",
      "default": "Drop 01 · Kampanj"
    },
    {
      "type": "text",
      "id": "word",
      "label": "Stort ord bakom bilderna",
      "default": "Object 07"
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Temats bild",
          "info": "Används när ingen bild är vald, t.ex. campaign-01, campaign-04, campaign-06, campaign-07 eller campaign-09."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Bildtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kampanjband",
      "blocks": [
        { "type": "frame", "settings": { "fallback": "campaign-01" } },
        { "type": "frame", "settings": { "fallback": "campaign-04" } },
        { "type": "frame", "settings": { "fallback": "campaign-06" } }
      ]
    }
  ]
}
{% endschema %}
