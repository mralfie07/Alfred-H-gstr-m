<section class="signup" id="anmal" aria-labelledby="SignupTitle-{{ section.id }}">
  <div class="signup__inner">
    <h2 class="heading" id="SignupTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: 'SignupForm', class: 'signup__form-wrap' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,drop-signup">
      {%- liquid
        assign error = false
        if form.errors
          assign error = true
        endif
      -%}
      <div class="signup__form">
        <label class="visually-hidden" for="SignupEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input
          id="SignupEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          inputmode="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          placeholder="{{ 'newsletter.placeholder' | t }}"
          {% if error %}aria-invalid="true" aria-describedby="SignupStatus-{{ section.id }}"{% endif %}
        >
        <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
      <p class="signup__status" id="SignupStatus-{{ section.id }}" role="status">
        {%- if form.posted_successfully? -%}
          {{ 'newsletter.success' | t }}
        {%- elsif error -%}
          {{ 'newsletter.error' | t }}
        {%- endif -%}
      </p>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .signup {
    padding: var(--s-7) var(--gutter);
  }

  .signup__inner {
    display: grid;
    gap: var(--s-4);
    max-width: 560px;
    margin: 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Drop-anmälan",
  "tag": "div",
  "class": "section-signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Få nästa droppet först"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Anmäl dig så får du ett mejl innan nästa objekt släpps.</p>"
    }
  ],
  "presets": [
    {
      "name": "Drop-anmälan"
    }
  ]
}
{% endschema %}
