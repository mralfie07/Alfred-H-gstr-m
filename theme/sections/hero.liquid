{%- liquid
  assign video = section.settings.video
  assign poster = section.settings.poster
  if poster == blank and video != blank
    assign poster = video.preview_image
  endif
  if poster != blank
    assign poster_url = poster | image_url: width: 1920
  else
    assign poster_url = 'hero-poster.webp' | asset_url
  endif

  # Phones get ~720p, larger screens ~1080p.
  assign small_url = ''
  assign large_url = ''
  if video != blank
    # Shopify transcodes uploads into several MP4 heights; pick the best one under each limit.
    assign small_h = 0
    assign large_h = 0
    for source in video.sources
      if source.mime_type == 'video/mp4'
        if source.height <= 720 and source.height > small_h
          assign small_url = source.url
          assign small_h = source.height
        endif
        if source.height <= 1080 and source.height > large_h
          assign large_url = source.url
          assign large_h = source.height
        endif
      endif
    endfor
    if large_url == blank
      assign large_url = video.sources | where: 'mime_type', 'video/mp4' | map: 'url' | first
    endif
  elsif section.settings.theme_video
    # Shopify trial stores can't upload video files, so the theme ships the film as two assets.
    assign small_url = 'hero-720.mp4' | asset_url
    assign large_url = 'hero-1080.mp4' | asset_url
  endif
-%}
<section class="hero" aria-label="{{ section.settings.label | escape }}">
  {%- if large_url != blank -%}
    <video
      class="hero__media"
      muted
      loop
      playsinline
      preload="metadata"
      poster="{{ poster_url }}"
      width="1928"
      height="1076"
      data-hero-video
      aria-hidden="true"
    >
      {%- if small_url != blank and small_url != large_url -%}
        <source src="{{ small_url }}" type="video/mp4" media="(max-width: 899px)">
      {%- endif -%}
      <source src="{{ large_url }}" type="video/mp4">
    </video>
  {%- elsif poster != blank -%}
    {{
      poster
      | image_url: width: 1920
      | image_tag: class: 'hero__media', widths: '750, 1100, 1500, 1920', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
    }}
  {%- else -%}
    <img
      class="hero__media"
      src="{{ poster_url }}"
      alt=""
      width="1920"
      height="1072"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  <span class="hero__veil" aria-hidden="true"></span>

  <div class="hero__copy page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="ui" data-scramble data-hero-kicker>{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="ui link" href="{{ section.settings.link | default: '#droppet' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- comment -%}
    First visit in a session (html.intro, set by snippets/motion-head): the screen is ink, the
    emblem's star turns while the year rolls to 2007 and the film loads. Then the star stretches
    into a horizon and the page splits open along it.
  {%- endcomment -%}
  <div class="curtain" aria-hidden="true" data-curtain>
    <span class="curtain__half curtain__half--top"></span>
    <span class="curtain__half curtain__half--bottom"></span>
    <span class="curtain__line"></span>
    <span class="curtain__star">{% render 'icon', name: 'star' %}</span>
    <p class="curtain__est">
      <span class="ui ui--small">{{ 'general.est' | t | split: '2007' | first | strip }}</span>
      <span class="curtain__year numeral">{% render 'numeral-roll', text: '2007' %}</span>
    </p>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    overflow: clip;
    background: var(--char);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(to top, rgb(12 12 11 / 0.72), rgb(12 12 11 / 0) 50%);

      @media (min-width: 900px) {
        background: linear-gradient(to top, rgb(12 12 11 / 0.6), rgb(12 12 11 / 0) 30%);
      }
    }
  }

  /* One 16:9 source for every screen: the whole frame on desktop, a centred square on phones and tablets. */
  .hero__media {
    width: 100%;
    height: auto;
    aspect-ratio: 1928 / 1076;
    object-fit: cover;

    @media (max-width: 899px) {
      aspect-ratio: 1 / 1;
      max-height: 72svh;
    }
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
  }

  .hero__copy {
    position: absolute;
    inset-inline: 0;
    bottom: var(--s-4);
    z-index: 2;
    display: grid;
    gap: var(--s-2);
    justify-items: start;

    @media (min-width: 900px) {
      bottom: var(--s-6);
      gap: var(--s-3);
    }
  }

  /* Leaving the hero: the film pushes in and sinks into ink, the line lifts away faster. */
  @supports (animation-timeline: view()) {
    .motion .hero__media {
      animation: hero-push linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }

    .motion .hero__veil {
      animation: hero-dim linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }

    .motion .hero__copy {
      animation: hero-lift linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 80%;
    }
  }

  @keyframes hero-push {
    to {
      scale: 1.16;
    }
  }

  @keyframes hero-dim {
    to {
      opacity: 0.85;
    }
  }

  @keyframes hero-lift {
    to {
      translate: 0 -140%;
      opacity: 0;
    }
  }

  /* The intro curtain */
  .curtain {
    display: none;
  }

  .intro .curtain {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: block;
    cursor: pointer;
  }

  .curtain__half {
    position: absolute;
    inset-inline: 0;
    height: calc(50% + 1px);
    background: var(--ink);
    transition: translate 1.3s var(--ease-in-out) 0.8s, box-shadow 0s linear 0.8s;
  }

  .curtain__half--top {
    top: 0;
  }

  .curtain__half--bottom {
    bottom: 0;
  }

  .curtain__line {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--bone);
    scale: 0 1;
    transition: scale 0.8s var(--ease-in-out), opacity 0.4s;
  }

  .curtain__star {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    color: var(--bone);
    animation:
      curtain-star-in 0.9s var(--ease-spring) 0.1s backwards,
      o7-star-turn 1.15s var(--ease-out) 0.55s infinite;
    transition: scale 0.8s var(--ease-in-out), opacity 0.5s var(--ease-out) 0.3s;

    & svg {
      width: 100%;
      height: 100%;
    }
  }

  .curtain__est {
    position: absolute;
    top: calc(50% + 40px);
    left: 0;
    right: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    color: var(--bone-dim);
    animation: o7-rise 0.9s var(--ease-out) 0.3s backwards;
    transition: opacity 0.35s, translate 0.6s var(--ease-out);
  }

  /* The year counts up to 2007 like an archive counter. */
  .curtain__year {
    font-size: clamp(3.25rem, 16vw, 7.5rem);
    color: var(--bone-dim);
    --roll-delay: 0.4s;
  }

  @keyframes curtain-star-in {
    from {
      opacity: 0;
      scale: 0.2;
      rotate: -135deg;
    }
  }

  /* Opening: the star stretches into the horizon, then the page splits along it. */
  .intro--open {
    & .curtain__star {
      animation: none;
      scale: 18 0.04;
      opacity: 0;
    }

    & .curtain__line {
      scale: 1 1;
      opacity: 0;
      transition: scale 0.8s var(--ease-in-out), opacity 0.2s linear 0.8s;
    }

    & .curtain__est {
      opacity: 0;
      translate: 0 12px;
    }

    /* The horizon splits: each half carries one edge of the line away. */
    & .curtain__half--top {
      translate: 0 -101%;
      box-shadow: inset 0 -1px 0 var(--bone);
    }

    & .curtain__half--bottom {
      translate: 0 101%;
      box-shadow: inset 0 1px 0 var(--bone);
    }
  }

  .intro--done .curtain {
    display: none;
  }

  /* What waits behind the curtain. */
  .intro .hero__media {
    transform: scale(1.18);
  }

  .intro--open .hero__media {
    transform: none;
    transition: transform 2.6s var(--ease-out) 0.8s;
  }

  .intro .section-header {
    translate: 0 -100%;
  }

  .intro--open .section-header {
    translate: none;
    transition: translate 1s var(--ease-out) 1.5s;
  }

  .intro .hero__copy > * {
    opacity: 0;
    translate: 0 18px;
  }

  .intro--open .hero__copy > * {
    opacity: 1;
    translate: none;
    transition: opacity 0.8s var(--ease-out) 1.6s, translate 1s var(--ease-out) 1.6s;
  }

  .intro--open .hero__copy > :nth-child(2) {
    transition-delay: 1.75s;
  }

  /* If scripts never run, the curtain lifts on its own. */
  .intro:not(.intro--open) .curtain {
    animation: curtain-failsafe 0.01s linear 6s forwards;
  }

  .intro:not(.intro--open) :is(.hero__copy > *, .section-header) {
    animation: curtain-failsafe-show 0.01s linear 6s forwards;
  }

  @keyframes curtain-failsafe {
    to {
      visibility: hidden;
    }
  }

  @keyframes curtain-failsafe-show {
    to {
      opacity: 1;
      translate: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.documentElement;
    const video = document.querySelector('[data-hero-video]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const play = () => {
      if (still.matches) {
        video?.pause();
        return;
      }
      video?.play().catch(() => {});
    };

    if (video) {
      play();
      still.addEventListener('change', play);
      // Pause when off screen to save battery on phones.
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) play();
        else video.pause();
      }).observe(video);
    }

    if (!root.classList.contains('intro')) return;

    // Intro: the film buffers behind the curtain. Open once it plays, but let the star turn for a
    // moment first, and never hold the page for long. A click or a key opens it at once.
    const curtain = document.querySelector('[data-curtain]');
    let opened = false;
    const open = () => {
      if (opened) return;
      opened = true;
      if (video) {
        video.currentTime = 0;
        play();
      }
      root.classList.add('intro--open');
      const kicker = document.querySelector('[data-hero-kicker]');
      if (kicker) window.theme?.scramble?.(kicker, kicker.textContent, { delay: 1600, duration: 900 });
      setTimeout(() => root.classList.add('intro--done'), 2900);
    };
    const whenReady = () => setTimeout(open, Math.max(0, 1900 - performance.now()));
    if (!video || (!video.paused && video.readyState >= 3)) whenReady();
    else {
      video.addEventListener('playing', whenReady, { once: true });
      // A source that can't be played reports on the <source>, not the video.
      video.querySelector('source:last-of-type')?.addEventListener('error', whenReady, { once: true });
    }
    setTimeout(open, Math.max(0, 3600 - performance.now()));
    curtain?.addEventListener('click', open);
    window.addEventListener('keydown', open, { once: true });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero-film",
  "tag": "div",
  "class": "section-hero",
  "limit": 1,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Film",
      "info": "Valfritt. Ersätter temats film (16:9, spelas utan ljud och loopar). Kräver betald plan."
    },
    {
      "type": "checkbox",
      "id": "theme_video",
      "label": "Använd filmen som följer med temat",
      "default": true,
      "info": "Gäller när ingen film är vald ovan. Provperioden tillåter inte uppladdade filmer."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Stillbild",
      "info": "Visas medan filmen laddar och när rörelse är avstängd. Lämna tomt för temats stillbild."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Beskrivning för skärmläsare",
      "default": "Kampanjfilm Drop 01"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Rad",
      "default": "Drop 01 · OBJECT #001 & #002"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Länktext",
      "default": "Handla droppet"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk",
      "info": "Lämna tomt för att länka till korset längre ner."
    }
  ],
  "presets": [
    {
      "name": "Hero-film"
    }
  ]
}
{% endschema %}
