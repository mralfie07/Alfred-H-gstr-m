{%- liquid
  assign video = section.settings.video
  assign poster = section.settings.poster
  if poster == blank and video != blank
    assign poster = video.preview_image
  endif
  if poster != blank
    assign poster_url = poster | image_url: width: 1920
  else
    assign poster_url = 'hero-poster.webp' | asset_url
  endif

  # Phones get ~720p, larger screens ~1080p.
  assign small_url = ''
  assign large_url = ''
  if video != blank
    # Shopify transcodes uploads into several MP4 heights; pick the best one under each limit.
    assign small_h = 0
    assign large_h = 0
    for source in video.sources
      if source.mime_type == 'video/mp4'
        if source.height <= 720 and source.height > small_h
          assign small_url = source.url
          assign small_h = source.height
        endif
        if source.height <= 1080 and source.height > large_h
          assign large_url = source.url
          assign large_h = source.height
        endif
      endif
    endfor
    if large_url == blank
      assign large_url = video.sources | where: 'mime_type', 'video/mp4' | map: 'url' | first
    endif
  elsif section.settings.theme_video
    # Shopify trial stores can't upload video files, so the theme ships the film as two assets.
    assign small_url = 'hero-720.mp4' | asset_url
    assign large_url = 'hero-1080.mp4' | asset_url
  endif
-%}
<section class="hero{% if section.settings.full_desktop %} hero--full{% endif %}" aria-label="{{ section.settings.label | escape }}">
  {%- if large_url != blank -%}
    <video
      class="hero__media"
      muted
      loop
      playsinline
      preload="metadata"
      poster="{{ poster_url }}"
      width="1928"
      height="1076"
      data-hero-video
      aria-hidden="true"
    >
      {%- if small_url != blank and small_url != large_url -%}
        <source src="{{ small_url }}" type="video/mp4" media="(max-width: 899px)">
      {%- endif -%}
      <source src="{{ large_url }}" type="video/mp4">
    </video>
  {%- elsif poster != blank -%}
    {{
      poster
      | image_url: width: 1920
      | image_tag: class: 'hero__media', widths: '750, 1100, 1500, 1920', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
    }}
  {%- else -%}
    <img
      class="hero__media"
      src="{{ poster_url }}"
      alt=""
      width="1920"
      height="1072"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  <span class="hero__veil" aria-hidden="true"></span>

  <div class="hero__copy page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="ui ui--small" data-scramble>{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.link_label != blank or section.settings.link_2_label != blank -%}
      <p class="hero__links">
        {%- if section.settings.link_label != blank -%}
          <a class="ui link" href="{{ section.settings.link | default: '#drop' }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
        {%- if section.settings.link_2_label != blank -%}
          <a class="ui link" href="{{ section.settings.link_2 | default: '#campaign' }}">{{ section.settings.link_2_label }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- if large_url != blank -%}
    <button
      class="icon-button hero__toggle"
      type="button"
      data-hero-toggle
      data-label-pause="{{ 'hero.pause' | t | escape }}"
      data-label-play="{{ 'hero.play' | t | escape }}"
      aria-label="{{ 'hero.pause' | t | escape }}"
    >
      <span class="hero__toggle-pause">{% render 'icon', name: 'pause' %}</span>
      <span class="hero__toggle-play">{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
</section>

{% stylesheet %}
  .hero {
    position: relative;
    overflow: clip;
    background: var(--char);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(to top, rgb(12 12 11 / 0.72), rgb(12 12 11 / 0) 50%);

      @media (min-width: 900px) {
        background: linear-gradient(to top, rgb(12 12 11 / 0.6), rgb(12 12 11 / 0) 30%);
      }
    }
  }

  /* One 16:9 source for every screen: the whole frame on desktop, a centred square on phones and tablets. */
  .hero__media {
    width: 100%;
    height: auto;
    aspect-ratio: 1928 / 1076;
    object-fit: cover;

    @media (max-width: 899px) {
      aspect-ratio: 1 / 1;
      max-height: 72svh;
    }
  }

  /* Full screen on desktop: the film fills the window, the header floats on top of it. */
  .hero--full .hero__media {
    @media (min-width: 900px) {
      height: 100svh;
      aspect-ratio: auto;
    }
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
  }

  /* Centred at the foot of the film: the line, the object's name, then the links side by side. */
  .hero__copy {
    position: absolute;
    inset-inline: 0;
    bottom: var(--s-5);
    z-index: 2;
    display: grid;
    gap: var(--s-2);
    justify-items: center;
    padding-inline: var(--gutter);

    @media (min-width: 900px) {
      padding-inline: 56px; /* clear of the pause button in the corner */
    }
    text-align: center;

    @media (min-width: 900px) {
      bottom: var(--s-7);
      gap: var(--s-3);
    }
  }

  .hero__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4.4vw, 3.25rem);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-4);
    margin: var(--s-1) 0 0;

    & .ui {
      @media (max-width: 899px) {
        font-size: 0.6875rem; /* both links on one line on a phone */
      }
    }

    @media (min-width: 900px) {
      column-gap: var(--s-5);
    }
  }

  /* Pause: top right under the header on a phone (the links fill the foot), bottom left on desktop. */
  .hero__toggle {
    position: absolute;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    right: calc(var(--gutter) - 10px);
    z-index: 3;
    opacity: 0.8;
    transition: opacity 0.2s;

    &:hover {
      opacity: 1;
    }

    & svg {
      width: 20px;
      height: 20px;
    }

    @media (min-width: 900px) {
      top: auto;
      right: auto;
      bottom: calc(var(--s-7) - 10px);
      left: calc(var(--gutter) - 10px);
    }
  }

  .hero__toggle-play,
  .hero__toggle[data-paused] .hero__toggle-pause {
    display: none;
  }

  .hero__toggle[data-paused] .hero__toggle-play {
    display: contents;
  }

  .hero__toggle-pause {
    display: contents;
  }

  /* Leaving the hero: the film pushes in and sinks into ink, the line lifts away faster. */
  @supports (animation-timeline: view()) {
    .motion .hero__media {
      animation: hero-push linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }

    .motion .hero__veil {
      animation: hero-dim linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }

    .motion .hero__copy {
      animation: hero-lift linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 80%;
    }
  }

  @keyframes hero-push {
    to {
      scale: 1.16;
    }
  }

  @keyframes hero-dim {
    to {
      opacity: 0.85;
    }
  }

  @keyframes hero-lift {
    to {
      translate: 0 -140%;
      opacity: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const video = document.querySelector('[data-hero-video]');
    const toggle = document.querySelector('[data-hero-toggle]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    // The visitor's own choice with the button wins over reduced motion and over scrolling back.
    let choice = null;
    const show = () => {
      if (!toggle || !video) return;
      const paused = video.paused;
      toggle.toggleAttribute('data-paused', paused);
      toggle.setAttribute('aria-label', paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause);
    };
    const play = () => {
      if (choice === 'pause' || (still.matches && choice !== 'play')) {
        video?.pause();
        return;
      }
      video?.play().catch(show);
    };
    video?.addEventListener('play', show);
    video?.addEventListener('pause', show);
    toggle?.addEventListener('click', () => {
      choice = video.paused ? 'play' : 'pause';
      play();
    });

    if (video) {
      play();
      show();
      still.addEventListener('change', play);
      // Pause when off screen to save battery on phones.
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) play();
        else video.pause();
      }).observe(video);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero-film",
  "tag": "div",
  "class": "section-hero",
  "limit": 1,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Film",
      "info": "Valfritt. Ersätter temats film (16:9, spelas utan ljud och loopar). Kräver betald plan."
    },
    {
      "type": "checkbox",
      "id": "theme_video",
      "label": "Använd filmen som följer med temat",
      "default": true,
      "info": "Gäller när ingen film är vald ovan. Provperioden tillåter inte uppladdade filmer."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Stillbild",
      "info": "Visas medan filmen laddar och när rörelse är avstängd. Lämna tomt för temats stillbild."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Beskrivning för skärmläsare",
      "default": "Kampanjfilm Drop 01"
    },
    {
      "type": "checkbox",
      "id": "full_desktop",
      "label": "Helskärm på dator",
      "default": true,
      "info": "Filmen fyller hela fönstret från 900 px bredd. I mobilen visas den som en kvadrat."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Rad",
      "default": "Drop 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "OBJECT #001"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Länktext",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk",
      "info": "Lämna tomt för att länka till korset längre ner."
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Andra länkens text",
      "default": "See the campaign"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Andra länken",
      "info": "Lämna tomt för att länka till kampanjbilderna längre ner."
    }
  ],
  "presets": [
    {
      "name": "Hero-film"
    }
  ]
}
{% endschema %}
