<dialog class="drawer" id="cart-drawer" aria-labelledby="CartDrawerTitle">
  <div class="drawer__inner" id="CartDrawerContent" data-cart-count="{{ cart.item_count }}">
    <div class="drawer__head">
      <h2 class="ui" id="CartDrawerTitle">
        {{- 'cart.title' | t }}
        {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif -%}
      </h2>
      <button class="icon-button" type="button" data-close-dialog aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="drawer__body">
      {%- if cart.item_count > 0 -%}
        {% render 'cart-lines', compact: true %}
      {%- else -%}
        <div class="cart-empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a class="button button--ghost" href="{{ routes.root_url }}#droppet">{{ 'cart.continue' | t }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__foot">
        <div class="cart-summary__row ui">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="muted" style="font-size: 0.875rem">{{ 'cart.taxes_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="button button--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </form>
        <a class="ui link" href="{{ routes.cart_url }}" style="justify-self: center">{{ 'cart.view_full' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "Varukorgslåda",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
