{% doc %}
  Line icons drawn at 24 px with a 1.4 stroke, and the emblem's four-point star.

  @param {string} name - menu, bag, close, arrow, star

  @example
  {% render 'icon', name: 'bag' %}
{% enddoc %}
{%- case name -%}
  {%- when 'menu' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
  {%- when 'bag' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 4h2.6l2.3 11h11l2.1-8H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'arrow' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="stroke-width:1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false" fill="currentColor"><path d="M20 0 C21.2 13 27 18.8 40 20 C27 21.2 21.2 27 20 40 C18.8 27 13 21.2 0 20 C13 18.8 18.8 13 20 0 Z"/></svg>
{%- endcase -%}
