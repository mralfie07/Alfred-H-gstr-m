{%- comment -%}
  The queue page. While the store is password protected every visitor lands here: the campaign film,
  a sign-up that tags the customer for the drop queue, an optional countdown and the object itself.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['object-001-svart-camo']
  endif
  if product != blank
    capture number
      render 'object-number', title: product.title, part: 'number'
    endcapture
    assign number = number | strip
    assign digits = number | remove: '#'
  endif
  assign tags = section.settings.tags | default: 'newsletter,drop-signup'
-%}

<div class="queue">
  <section class="queue__stage" aria-labelledby="QueueTitle">
    {%- if section.settings.show_video -%}
      <video
        class="queue__film"
        muted
        loop
        playsinline
        preload="metadata"
        poster="{{ 'hero-poster.webp' | asset_url }}"
        aria-hidden="true"
        data-queue-film
      >
        <source src="{{ 'hero-720.mp4' | asset_url }}" type="video/mp4" media="(max-width: 899px)">
        <source src="{{ 'hero-1080.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}

    <header class="queue__top">
      <img class="queue__logo" src="{{ 'wordmark.png' | asset_url }}" alt="{{ shop.name }}" width="1180" height="140">
    </header>

    <div class="queue__body">
      {%- if section.settings.kicker != blank -%}
        <p class="ui">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.drop_date != blank -%}
        <div class="queue__countdown" data-countdown="{{ section.settings.drop_date | escape }}" hidden>
          <p class="visually-hidden" data-countdown-label></p>
          <ol class="queue__units" aria-hidden="true">
            <li><span data-unit="d">00</span><small class="ui ui--small">{{ 'queue.days' | t }}</small></li>
            <li><span data-unit="h">00</span><small class="ui ui--small">{{ 'queue.hours' | t }}</small></li>
            <li><span data-unit="m">00</span><small class="ui ui--small">{{ 'queue.minutes' | t }}</small></li>
            <li><span data-unit="s">00</span><small class="ui ui--small">{{ 'queue.seconds' | t }}</small></li>
          </ol>
          <p class="queue__open ui" data-countdown-open hidden>{{ 'queue.open' | t }}</p>
        </div>
      {%- endif -%}

      <h1 class="queue__title heading" id="QueueTitle">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="queue__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'QueueForm', class: 'queue__form' -%}
        <input type="hidden" name="contact[tags]" value="{{ tags | escape }}">
        {%- if form.posted_successfully? -%}
          <p class="queue__done" role="status">
            <span class="queue__done-star" aria-hidden="true">{% render 'icon', name: 'star' %}</span>
            {{ section.settings.success }}
          </p>
        {%- else -%}
          <label class="visually-hidden" for="QueueEmail">{{ 'newsletter.label' | t }}</label>
          <input
            class="queue__input"
            id="QueueEmail"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            inputmode="email"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            placeholder="{{ 'newsletter.placeholder' | t }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="QueueError"{% endif %}
          >
          <button class="button button--full" type="submit">{{ section.settings.button }}</button>
          {%- if form.errors -%}
            <p class="queue__error" id="QueueError" role="alert">{{ 'newsletter.error' | t }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if shop.password_message != blank -%}
        <p class="queue__note ui ui--small">{{ shop.password_message }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- if product != blank -%}
    <section class="queue__object concrete" aria-label="{{ product.title | escape }}">
      <span class="queue__numeral numeral" aria-hidden="true">{{ digits }}</span>
      {% render 'object-image',
        product: product,
        side: 'bak',
        width: 1200,
        loading: 'lazy',
        class: 'queue__garment',
        sizes: '(min-width: 900px) 520px, 86vw'
      %}
      <p class="queue__data ui">
        <span>OBJECT {{ number }}</span>
        {%- if product.type != blank %}<span>{{ product.type }}</span>{% endif %}
        <span>{{ product.price | money_with_currency | remove: ',00' }}</span>
      </p>
    </section>
  {%- endif -%}

  <footer class="queue__foot">
    {%- if request.page_type == 'password' -%}
      <details class="queue__entry">
        <summary class="ui ui--small">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'queue__password' -%}
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <div class="signup__form">
            <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
            <button type="submit" aria-label="{{ 'password.submit' | t }}">{% render 'icon', name: 'arrow' %}</button>
          </div>
          {%- if form.errors -%}<p role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
        {%- endform -%}
      </details>
    {%- endif -%}
    <p class="ui ui--small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; {{ 'general.est' | t }}</p>
  </footer>
</div>

{% stylesheet %}
  .queue__stage {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    padding: calc(var(--s-5) + env(safe-area-inset-top, 0px)) var(--gutter) calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(to top, rgb(12 12 11 / 0.92) 0%, rgb(12 12 11 / 0.55) 45%, rgb(12 12 11 / 0.35) 100%);
    }
  }

  .queue__film {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .queue__top {
    display: flex;
    justify-content: center;
  }

  .queue__logo {
    width: clamp(150px, 46vw, 240px);
  }

  .queue__body {
    display: grid;
    align-content: end;
    gap: var(--s-4);
    width: min(100%, 520px);
    margin-inline: auto;
    text-align: center;
  }

  .queue__title {
    font-size: clamp(2.25rem, 11vw, 4rem);
  }

  .queue__text {
    max-width: 42ch;
    margin-inline: auto;
    color: var(--bone);
    opacity: 0.85;
  }

  .queue__form {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .queue__input {
    width: 100%;
    height: 58px;
    padding: 0 var(--s-4);
    border: 1px solid var(--bone);
    border-radius: 0;
    font-size: 1rem;
    text-align: center;
    color: var(--bone);
    background: rgb(12 12 11 / 0.35);
    backdrop-filter: blur(6px);

    &::placeholder {
      color: var(--stone);
    }
  }

  .queue__error {
    font-size: 0.875rem;
  }

  .queue__done {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-4);
    border: 1px solid var(--bone-dim);
    font-size: 1.0625rem;
    background: rgb(12 12 11 / 0.45);
  }

  .queue__done-star {
    width: 28px;
    height: 28px;
    color: var(--bone);

    & svg {
      width: 100%;
      height: 100%;
    }
  }

  .queue__note {
    color: var(--stone);
  }

  /* Countdown: four archive-style counters. */
  .queue__units {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-2);
    margin: 0 auto;
    padding: 0;
    width: min(100%, 360px);
    list-style: none;

    & li {
      display: grid;
      gap: var(--s-1);
      padding-block: var(--s-2);
      border-top: 1px solid var(--bone-dim);
    }

    & span {
      font-stretch: 125%;
      font-weight: 300;
      font-size: clamp(1.75rem, 9vw, 2.5rem);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    & small {
      color: var(--stone);
    }
  }

  /* The object, below the fold. */
  .queue__object {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding: var(--s-7) var(--gutter);
    overflow: hidden;
    isolation: isolate;
  }

  .queue__numeral {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    font-size: min(56vw, 340px);
    color: var(--bone-dim);
  }

  .queue__garment {
    width: min(86vw, 520px);
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 18px 16px rgb(12 12 11 / 0.32));
  }

  .queue__data {
    text-align: center;

    & span + span::before {
      content: "·";
      margin: 0 0.7em;
      color: var(--bone-dim);
    }
  }

  .queue__foot {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding: var(--s-6) var(--gutter) calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
    color: var(--stone);
    text-align: center;
  }

  .queue__entry summary {
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 4px;

    &::-webkit-details-marker {
      display: none;
    }
  }

  .queue__password {
    width: min(calc(100vw - 2 * var(--gutter)), 360px);
    margin-top: var(--s-3);
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const film = document.querySelector('[data-queue-film]');
    if (film && !still.matches) film.play().catch(() => {});

    const box = document.querySelector('[data-countdown]');
    if (!box) return;
    const target = new Date(box.dataset.countdown.replace(' ', 'T'));
    if (Number.isNaN(target.getTime())) return;
    box.hidden = false;
    const units = Object.fromEntries([...box.querySelectorAll('[data-unit]')].map((el) => [el.dataset.unit, el]));
    const label = box.querySelector('[data-countdown-label]');
    const pad = (n) => String(n).padStart(2, '0');

    const tick = () => {
      const left = Math.max(0, target - Date.now());
      if (!left) {
        box.querySelector('.queue__units').hidden = true;
        box.querySelector('[data-countdown-open]').hidden = false;
        return;
      }
      const s = Math.floor(left / 1000);
      const parts = { d: Math.floor(s / 86400), h: Math.floor((s % 86400) / 3600), m: Math.floor((s % 3600) / 60), s: s % 60 };
      for (const [k, v] of Object.entries(parts)) units[k].textContent = pad(v);
      label.textContent = `${parts.d} d ${parts.h} h ${parts.m} min`;
      setTimeout(tick, 1000 - (Date.now() % 1000));
    };
    tick();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Kö-sida",
  "settings": [
    {
      "type": "paragraph",
      "content": "Visas för alla besökare så länge butiken är lösenordsskyddad (Online Store → Inställningar → Lösenordsskydd)."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Rad överst",
      "default": "Drop 01 · OBJECT #001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Ställ dig i kön"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Droppet är begränsat. Lämna din e-post så får du ett mejl när det öppnar, före alla andra.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Knapptext",
      "default": "Ställ dig i kön"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Text när man har anmält sig",
      "default": "Du står i kön. Vi mejlar dig innan droppet öppnar."
    },
    {
      "type": "text",
      "id": "drop_date",
      "label": "Släppdatum (valfritt)",
      "info": "Skriv t.ex. 2026-11-07 18:00 för en nedräkning. Lämna tomt för att dölja den."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Taggar på kunderna i kön",
      "default": "newsletter,drop-01-ko",
      "info": "Kommaseparerat. Används för att mejla just kön när droppet öppnar."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Objekt som visas"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Kampanjfilmen i bakgrunden",
      "default": true
    }
  ]
}
{% endschema %}
