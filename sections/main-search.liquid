<div class="page-width search-page">
  <header class="page-head">
    <h1 class="heading">{{ 'search.title' | t }}</h1>
    <search>
      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchInput">{{ 'search.label' | t }}</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.label' | t }}" autocomplete="off">
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </form>
    </search>
  </header>

  {%- if search.performed -%}
    <p class="muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
    <ul class="search-page__results" role="list">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          <li>
            <a class="cart-line" href="{{ item.url }}">
              <span class="cart-line__media concrete">{% render 'object-image', product: item, side: 'fram', width: 300 %}</span>
              <span class="cart-line__info">
                <span class="cart-line__title">{{ item.title }}</span>
                <span class="cart-line__meta">{{ item.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page {
    padding-bottom: var(--s-8);
  }

  .search-page__form {
    display: grid;
    grid-template-columns: 1fr auto;
    max-width: 560px;
    margin-top: var(--s-4);
    border: 1px solid var(--bone);

    & input {
      min-width: 0;
      height: 56px;
      padding: 0 var(--s-4);
      border: 0;
      border-radius: 0;
      font-size: 1rem;
      background: transparent;
    }

    & button {
      display: grid;
      place-items: center;
      width: 56px;
      border: 0;
      color: var(--ink);
      background: var(--bone);

      & svg {
        width: 22px;
        height: 22px;
      }
    }
  }

  .search-page__results {
    display: grid;
    gap: var(--s-5);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;

    & a {
      text-decoration: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sök",
  "settings": []
}
{% endschema %}
