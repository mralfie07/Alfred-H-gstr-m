<div class="password">
  <img class="password__logo" src="{{ 'wordmark.png' | asset_url }}" alt="{{ shop.name }}" width="1180" height="140">
  {%- if shop.password_message != blank -%}
    <p class="ui">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'password__signup' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,drop-signup">
    <label class="ui ui--small" for="PasswordSignup">{{ 'newsletter.label' | t }}</label>
    <div class="signup__form">
      <input id="PasswordSignup" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
      <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', name: 'arrow' %}</button>
    </div>
    <p class="signup__status" role="status">
      {%- if form.posted_successfully? -%}{{ 'newsletter.success' | t }}{%- elsif form.errors -%}{{ 'newsletter.error' | t }}{%- endif -%}
    </p>
  {%- endform -%}

  <details class="password__entry">
    <summary class="ui ui--small muted">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'password__form' -%}
      <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
      <div class="signup__form">
        <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
        <button type="submit" aria-label="{{ 'password.submit' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
      {%- if form.errors -%}<p role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>

{% stylesheet %}
  .password {
    display: grid;
    align-content: center;
    gap: var(--s-6);
    width: min(100%, 560px);
    min-height: 100svh;
    margin-inline: auto;
    padding: var(--s-7) var(--gutter);
  }

  .password__logo {
    width: clamp(160px, 50vw, 260px);
  }

  .password__signup,
  .password__form {
    display: grid;
    gap: var(--s-3);
  }

  .password__entry summary {
    cursor: pointer;
    margin-bottom: var(--s-3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lösenordssida",
  "settings": []
}
{% endschema %}
